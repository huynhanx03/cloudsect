{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CloudSect",
  "version": "0.1.0",
  "identifier": "app.cloudsect.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "CloudSect", "width": 1440, "height": 900, "minWidth": 1000, "minHeight": 680, "center": true, "visible": true }
    ],
    "security": { "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": ["app", "dmg"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": []
  }
}
